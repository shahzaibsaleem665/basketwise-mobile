{
  "expo": {
    "name": "BasketWise",
    "slug": "basketwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "basketwise",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.codalyst.basketwise",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codalyst.basketwise",
      "adaptiveIcon": {
        "backgroundColor": "#1F4D33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F4D33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BasketWise reads screenshots of your shopping lists and recipes to find the items.",
          "cameraPermission": "BasketWise uses the camera to read a shopping list you snap."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BasketWise uses your location once to find your postcode, so prices match your area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}